# The LLM judge uses the first provider configured below:
# Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else local Ollama.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_WORKSPACE_ID=

# OPENAI_API_KEY=your_openai_api_key_here

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Seconds before a judge HTTP request is abandoned (default 120)
# JUDGE_TIMEOUT=120
